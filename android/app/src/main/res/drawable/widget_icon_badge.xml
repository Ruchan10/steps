<?xml version="1.0" encoding="utf-8"?>
<!-- Footprints on a tinted circle, for the plain steps widget. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_track" />
            <size
                android:width="100dp"
                android:height="100dp" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:drawable="@drawable/widget_footprints"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp" />
</layer-list>
