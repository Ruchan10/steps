<?xml version="1.0" encoding="utf-8"?>
<!-- Small goal ring with footprints inside, for one-row widgets. Level as in widget_ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:innerRadius="38dp"
            android:shape="ring"
            android:thickness="10dp"
            android:useLevel="false">
            <solid android:color="@color/widget_track" />
            <size
                android:width="100dp"
                android:height="100dp" />
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">
            <shape
                android:innerRadius="38dp"
                android:shape="ring"
                android:thickness="10dp"
                android:useLevel="true">
                <solid android:color="@color/widget_accent" />
                <size
                    android:width="100dp"
                    android:height="100dp" />
            </shape>
        </rotate>
    </item>
    <item
        android:bottom="27dp"
        android:drawable="@drawable/widget_footprints"
        android:left="27dp"
        android:right="27dp"
        android:top="27dp" />
</layer-list>
