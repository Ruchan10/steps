            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_muted" />

        <TextView
            android:id="@+id/widget_day_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
