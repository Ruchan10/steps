<?xml version="1.0" encoding="utf-8"?>
<!-- Last 7 days, oldest first. Included by the taller layouts and shown when there's room. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_chart"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginTop="12dp"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_bar_0"
            android:layout_width="12dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_track"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_muted" />

        <TextView
            android:id="@+id/widget_day_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_bar_1"
            android:layout_width="12dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_track"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_muted" />

        <TextView
            android:id="@+id/widget_day_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_bar_2"
            android:layout_width="12dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bar_track"
